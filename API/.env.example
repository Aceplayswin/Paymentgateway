PORT=3000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

DB_HOST=your_db_host
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

JWT_SECRET=your_jwt_secret_key
EXPIRES_TOKEN=24h
REFRESH_TOKEN=7d
REFRESH_TOKEN_MAX_AGE=604800000

# 32-byte (64 hex chars) key used to encrypt recoverable secrets at rest, e.g.
# merchant API key secrets (needed to verify HMAC request signatures).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In development this falls back to a key derived from JWT_SECRET; set it in production.
SECRETS_ENCRYPTION_KEY=

DB_SYNC_ALTER=false
DB_SYNC_FORCE=false

APP_NAME=Payment Gateway System

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=your_email@example.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM=your_email@example.com

# Payment Gateway (white-label). Razorpay is the hidden acquiring processor.
# Acquiring credentials are sourced from the environment below (NOT the DB and
# NOT the admin UI). The admin only chooses which connected gateway is active.
# PUBLIC_BASE_URL is used for hosted payment links returned by initiate endpoints.
PUBLIC_BASE_URL=http://localhost:3000

# Razorpay acquiring credentials (from the Razorpay dashboard). The environment
# (sandbox/production) is detected from the key id prefix (rzp_test_ / rzp_live_).
# When these are set, Razorpay shows as a "connected" gateway in the admin UI and
# can be activated. Webhook secret is optional (used to verify Razorpay webhooks).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Merchant KYC uploaded documents directory (optional)
KYC_UPLOAD_DIR=./uploads/kyc
