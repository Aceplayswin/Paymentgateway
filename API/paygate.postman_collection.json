{
  "info": {
    "name": "Ultraconic API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Complete API collection for Ultraconic PG. Import this file into Postman. Set the `baseUrl` collection variable to your server (default: http://localhost:3000)."
  },
  "variable": [
    { "key": "baseUrl",       "value": "http://localhost:3000" },
    { "key": "accessToken",   "value": "" },
    { "key": "refreshToken",  "value": "" },
    { "key": "otpSessionId",  "value": "" },
    { "key": "merchantId",    "value": "" },
    { "key": "transactionId", "value": "" },
    { "key": "payoutId",      "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "(async () => {",
          "  const requestPath = pm.request.url.getPath();",
          "  const publicPaths = ['/api/auth/login', '/api/auth/register', '/api/auth/refresh', '/api/auth/verify-otp', '/api/auth/verify-registration-otp', '/api/auth/resend-otp', '/api/auth/forgot-password', '/api/auth/verify-reset-otp', '/api/auth/reset-password'];",
          "  if (publicPaths.some((path) => requestPath.includes(path))) {",
          "    return;",
          "  }",
          "",
          "  const accessToken = pm.collectionVariables.get('accessToken');",
          "  const refreshToken = pm.collectionVariables.get('refreshToken');",
          "",
          "  const isExpired = (token) => {",
          "    if (!token) return true;",
          "    try {",
          "      const payload = JSON.parse(atob(token.split('.')[1]));",
          "      const now = Math.floor(Date.now() / 1000);",
          "      return !payload.exp || payload.exp <= now + 30;",
          "    } catch (error) {",
          "      return true;",
          "    }",
          "  };",
          "",
          "  if (!refreshToken || !isExpired(accessToken)) {",
          "    return;",
          "  }",
          "",
          "  const baseUrl = pm.collectionVariables.get('baseUrl');",
          "  const refreshResponse = await pm.sendRequest({",
          "    url: `${baseUrl}/api/auth/refresh`,",
          "    method: 'POST',",
          "    header: { 'Content-Type': 'application/json' },",
          "    body: {",
          "      mode: 'raw',",
          "      raw: JSON.stringify({ refreshToken })",
          "    }",
          "  });",
          "",
          "  if (refreshResponse.code === 200) {",
          "    const json = refreshResponse.json();",
          "    if (json.data && json.data.accessToken) {",
          "      pm.collectionVariables.set('accessToken', json.data.accessToken);",
          "    }",
          "  }",
          "})();"
        ]
      }
    }
  ],
