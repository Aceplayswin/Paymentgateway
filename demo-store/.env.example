# ---- DummyMart demo store config -------------------------------------------
# Copy this file to .env and fill in your local values.

# Port the demo store runs on (keep it off 3000/5173 so it doesn't clash with
# the Paygate API or the FE dev server).
PORT=4500

# Public URL of THIS demo store. Used to build the redirect/callback URLs that
# are handed to the Paygate gateway. Must be reachable by the gateway for the
# server-to-server callback to land (use ngrok if testing the webhook remotely).
STORE_BASE_URL=http://localhost:4500

# ---- Paygate (Ultraconic PG) API -------------------------------------------
# Base URL of the running Paygate API server (the one in ../API).
PAYGATE_API_URL=http://localhost:3000

# Merchant API keys. These IDENTIFY the merchant: the platform resolves the key
# to the owning merchant and routes the payment to that merchant's Razorpay
# account. Generate them from the merchant dashboard (or
# POST /api/developer/api-keys/generate) and paste them here. The secret is only
# shown once at generation time — store it now, it can't be retrieved later.
#
#   PAYGATE_KEY_ID     : public key  (pk_test_… / pk_live_…)  -> sent as X-Api-Key
#   PAYGATE_KEY_SECRET : secret key  (sk_test_… / sk_live_…)  -> signs each request
PAYGATE_KEY_ID=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
PAYGATE_KEY_SECRET=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Which gateway provider to use on Paygate. Currently only "razorpay".
PAYGATE_PROVIDER=razorpay
